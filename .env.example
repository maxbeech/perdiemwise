# Sentry (org maxed-labs, project perdiemwise_web). The DSN is not a secret.
# Set both in the production host's environment as well; NEXT_PUBLIC_ is inlined at build.
NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project-id>
SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project-id>
SENTRY_ORG=maxed-labs
SENTRY_PROJECT=perdiemwise_web
# Build-time only, for source-map upload. Never commit a value.
SENTRY_AUTH_TOKEN=
